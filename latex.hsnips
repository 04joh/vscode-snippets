	\preplabel{${2:globalcounter}}%
	\label{${2:globalcounter}:${3:zahl}}%
	$4
}
$0
endsnippet

snippet pdfeinfügen "PDF Einfügen" bA
\includepdf[pages=-, fitpaper=true]{${1:${VISUAL}}}					% Alle Seiten, Seitengröße des PDFs übernehmen
% Auch nützlich:
% \includepdf[pages=-, scale=0.9, pagecommand={}]{${1:${VISUAL}}}  	% Seitenzahl/Kopfzeile beibehalten
% \includepdf[pages=-, nup=2x1, landscape]{${1:${VISUAL}}} 			% zwei Seiten pro Blatt
endsnippet

snippet Extra "Extra Kapitel für TOC" bA
\phantomsection
\addcontentsline{toc}{extras}{${1:${VISUAL}}}
\chapter*{${1:${VISUAL}}}
endsnippet





