$0
endsnippet

snippet altaltneuesdok "LaTeX template for report document class with dynamic title and date" bA
\documentclass[12pt]{report}

\input{~/dotfiles/tex/templates/input.tex}

\WarningFilter{caption}{}

\usepackage{tkz-graph}
\usepackage{caption}
\usepackage{stackengine}


\title{${1:Titel}}
\author{Johannes Peters}

\begin{document}

\maketitle
\tableofcontents

\lhead{Johannes Peters}
\chead{${1:Titel}}
\rhead{${2:Semester}}

\setlength{\parindent}{0pt}
\countergroup${3:A}

$0



\end{document}
endsnippet


snippet altneuesdok "LaTeX template for report document class with dynamic title and date" bA
\documentclass[12pt]{report}

\input{~/dotfiles/tex/${1:202501}/input.tex}

\WarningFilter{caption}{}

\title{${2:Titel}}
\author{Johannes Peters}

\begin{document}

\maketitle
\tableofcontents

\lhead{Johannes Peters}
\chead{\hyperlink{toc}{${2:Titel}}}
\rhead{${3:Semester}}

\setlength{\parindent}{0pt}
\countergroup${4:A}

$0



\end{document}
endsnippet

snippet neuesdok "LaTeX template für Vorlesung" bA
\documentclass[12pt]{report}

\input{~/dotfiles/tex/${1:2026-2027}/${2|input,input-en|}.tex}


\title{${3:Titel}}
\author{Johannes Peters}


\begin{document}

\maketitle
\tableofcontents

\lhead{Johannes Peters}
\chead{\hyperlink{toc}{${3:Titel}}}
\rhead{${4:Semester}}

\countergroup${5:A}



\includeall{Vorlesungen} % Alle Dateien namens 01.tex, 02.tex, ... 99.tex im Ordner Vorlesungen werden eingebunden. 
$0


\printindex

\end{document}
endsnippet

snippet index "Index" iA
