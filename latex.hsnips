snippet math_commands "Math commands" b

\newcommand{\rvec}[1]{
    \begin{pmatrix}
        #1
    \end{pmatrix}
}
\newcommand{\brackets}[1]{
	\left(#1 \right)
}
\newcommand{\curly}[1]{
	\left\{#1 \right\}
}
\newcommand{\angular}[1]{
	\left\[#1 \right\]
}

endsnippet



