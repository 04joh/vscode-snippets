snippet ohnecounter "Algorithmus ohne Counter" Ab
\setcounter{algocf}{\value{algocf}-1}
\begin{algorithm}[H]
\renewcommand{\thealgocf}{} % Entfernt die Nummerierung für diesen Algorithmus
\caption*{${1:Titel}} % Keine Nummer in der Beschriftung
	\KwIn{$2}
	\KwOut{$3}
	$0
\end{algorithm}
% Zähler zurücksetzen, damit der nächste Algorithmus korrekt nummeriert wird
\stepcounter{algocf}
endsnippet

