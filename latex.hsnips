\usepackage{array}
\usepackage{varwidth}


\usepackage{blindtext}
\usepackage{enumerate}

\usepackage[a4paper, left=2cm, right=2cm, top=3cm]{geometry}

\setlength{\headheight}{13pt}



\begin{document}
\ihead{Arthur Henninger}
%\ihead{\_qRtrenH\&}
\chead{}
\ohead{}

\cfoot{\pagemark}


\begin{huge}
