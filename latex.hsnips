snippet mantikz "Tikz Hilfe Beispiele" iA 
% Linie \draw (0,0) -- (2,0) -- (2,1);
% Rechteck \draw (1,1) rectangle (1.5,1.5)
% Kreis für Schnittstellen \node[circle, draw, thick, minimum size=5pt, inner sep=0pt, fill] at (2,0) {};
% Hohler Kreis für NOT (Kreis am Ende) \draw[-{Circle [open, scale=1.5]}] (4,1.25) -- (1.5,1.25); 
% Schrift \node (variable) at (0, 4) {Text};
% Variante 1 Signal \draw (variable) -- (2,4);
% Variante 2 Signal \draw (0, 3) node [left] {A};
endsnippet

snippet `(\d+(.\d+)?),\s*(\d+(.\d+)?)\s*(gatterr)` "Gatter nach rechts" iAm
\draw (``rv = parseFloat(m[1])``, ``rv = parseFloat(m[3]) - 0.125``) rectangle (``rv = parseFloat(m[1])+0.75``, ``rv = parseFloat(m[3]) + 0.625``);
\node (gatter) at (``rv = parseFloat(m[1])+0.375``, ``rv = parseFloat(m[3])+0.25``) {$1};
\draw${2:[-{Circle [open, scale=1.5]\}]} (``rv = parseFloat(m[1]) + 1.5``, ``rv = parseFloat(m[3]) + 0.25``) -- (``rv = parseFloat(m[1]) + 0.75``, ``rv = parseFloat(m[3]) + 0.25``); 
endsnippet

snippet `(\d+(.\d+)?),\s*(\d+(.\d+)?)\s*(punkttikz)` "Knotenpunkt für Verkabelung" iA 
\node[circle, draw, thick, minimum size=5pt, inner sep=0pt, fill] at (``rv = m[1]``, ``rv = m[3]``) {};$0
endsnippet

snippet `(?:(\d+\.\d+(\.\d+)?)|(?:\((\d+\.\d+(\.\d+)?)\)))\s*ref` "Label für equation aus align" iA
(\ref{eq:``rv = m[3] ?? m[1]``})
endsnippet

snippet `(\((\d+\.\d+(\.\d+)?))\)\s*sara` "Ersetze" iA
``rv = m[2]``
endsnippet


snippet tikz "tikzpicture" wA
\begin{figure}[H]
	\centering
	\begin{extbild}
	\begin{tikzpicture}[scale=1]
		$1
	\end{tikzpicture}
	\end{extbild}
\end{figure}
endsnippet

snippet punkttikz "Knotenpunkt für Verkabelung" iA 
\node[circle, draw, thick, minimum size=5pt, inner sep=0pt, fill] at ($1, $2) {}; $0
endsnippet

