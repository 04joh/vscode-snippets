snippet graph "Start with an empty TikZ graph" A
\begin{minipage}{0.45\\textwidth}
	\preplabel{${2:globalcounter}}%
	\label{${2:globalcounter}:${3:zahl}}%
	$4
	\begin{tikzpicture}
		[scale=.6]
		$0
	\end{tikzpicture}
	\captionof{figure}{${1:Graph}}
\end{minipage}
endsnippet

snippet funktionplot "Funktionsgraph von x^2 in tikz" A
\begin{tikzpicture}
  \begin{axis}[
    axis lines = middle, % Achsen mittig zeichnen
    xlabel = $x$, % x-Achsen-Beschriftung
    ylabel = $y$, % y-Achsen-Beschriftung
    xmin=-5, xmax=5, % Bereich für x
    ymin=0, ymax=25, % Bereich für y
    =-5:5, % x-Bereich für die Funktion
    samples=100, % Anzahl der Punkte für den Graphen
    ]
    \addplot[blue, thick] {x^2}; % Plot der Funktion y = x^2
  \end{axis}
\end{tikzpicture}
endsnippet

snippet knoten "Add a vertex to the TikZ graph" A
\Vertex[x=${1:0}, y=${2:0}]{${3:A}}
$0
endsnippet

snippet kante "Add an edge between vertices in the TikZ graph" A
\Edge[](${1:A})(${2:B})
$0
endsnippet

