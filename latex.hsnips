snippet komdia3 "Kommutatives Diagramm" iA
\begin{figure}[H]
	\centering
	\begin{tikzpicture}[scale=1]
		% Verwende dashed, |->, to[bend right=20], ...
		\node (X) at (0,0) {$1};
        \node (Y) at (4,0) {$2};
        \node (Z) at (2,-2) {$3};
        \draw[->] (X) -- (Y) node[midway, above] {$4}; 
        \draw[->] (X) -- (Z) node[midway, below left] {$5}; 
        \draw[->] (Y) -- (Z) node[midway, below right]{$6}; 
	\end{tikzpicture}
\end{figure}
endsnippet

snippet komdia4 "Kommutatives Diagramm" iA
\begin{figure}[H]
	\centering
	\begin{tikzpicture}[scale=1]
		% Verwende dashed, |->, to[bend right=20], ...
		\node (a) at (0,0) {$1};		% unten links
        \node (b) at (3,0) {$2};		% unten rechts
        \node (c) at (3,3) {$3};		% oben rechts
        \node (d) at (0,3) {$4};		% oben links
        \draw[->] (a) -- (b) node[midway, below] {$5};
        \draw[->] (c) -- (b) node[midway, right] {$6};
        \draw[->] (d) -- (c) node[midway, above] {$7};
        \draw[->] (d) -- (a) node[midway, left] {$8};
	\end{tikzpicture}
\end{figure}
endsnippet

snippet BwU "B([w]_H, U)" iAm
B([w]_H, U)
endsnippet

snippet BxU "B([w]_H, U)" iAm
