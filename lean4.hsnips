// Für die Abgabe

snippet `\b(?:name|Niklas|niklas|Johannes|johannes|Tom|tom)` "Name für die Abgabe" Ah
``
const dateiname = (path ?? "").toLowerCase();
const triggername = m[0].toLowerCase();
const usernamen = {tom: "Tom Finken", johannes: "Johannes Peters", niklas: "Niklas Broicher"};
let username = "name";
let echtername = "name";
for (const [key, value] of Object.entries(usernamen)) {
    if (dateiname.includes(key)) {
        username = key;
        echtername = value;
    }
}
let ausgabe = "undefiniert";
if (triggername == username || triggername == "name") {
    ausgabe = `${echtername}`;
} else {
    ausgabe = `Hallo ${echtername}, du bist garnicht ${usernamen[triggername]}`;
}
rv = ausgabe;
``
endsnippet



