
// JavaScript Variablen, die in jedem JavaScript-Snippet-Block verfügbar sind

global
const greek = {
    alpha:"α", beta:"β", gamma:"γ", delta:"δ", eps:"ε", zeta:"ζ",
    eta:"η", theta:"θ", iota:"ι", kappa:"κ", lambda:"λ", mu:"μ",
    nu:"ν", xi:"ξ", omicron:"ο", pi:"π", rho:"ρ", sigma:"σ",
    tau:"τ", upsilon:"υ", phi:"φ", chi:"χ", psi:"ψ", omega:"ω",
    // Ausnahmen
    lamm:"λ", muu:"μ", nuu:"ν", pii:"π", tauu:"τ", omegaa:"ω" };
const upper = {
    alpha:"Α", beta:"Β", gamma:"Γ", delta:"Δ", eps:"Ε", zeta:"Ζ",
    eta:"Η", theta:"Θ", iota:"Ι", kappa:"Κ", lambda:"Λ", mu:"Μ",
    nu:"Ν", xi:"Ξ", omicron:"Ο", pi:"Π", rho:"Ρ", sigma:"Σ",
    tau:"Τ", upsilon:"Υ", phi:"Φ", chi:"Χ", psi:"Ψ", omega:"Ω",
    // Ausnahmen
    gammaa:"Γ", lamm:"Λ" };
const names = Object.keys(greek).join("|");
endglobal
// Ausnahmen (Trigger vom Snippet muss angepasst werden und angepasster name ganz oben in global ergänzt werden):
// Gammaa statt Gamma
// lamm/Lamm zusätzlich zu lambda/Lambda
// muu statt mu
// nuu statt nu
// pii statt pi
// tauu statt tau
// omegaa statt omega



