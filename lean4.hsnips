snippet claudealt "Lokales Modell fragen" wA
``
const fs = require("fs");
const { fileURLToPath } = require("url");
const { spawnSync } = require("child_process");

const MODELL = "qwen2.5-coder:7b";
const SYSTEM_PROMPT = `
You are an expert Lean 4 theorem prover specializing in Mathlib.

Your task is to replace the LAST occurrence of the exact placeholder
"claude" in the provided Lean source file with a valid Lean 4 proof.

STRICT RULES:
- Return ONLY the replacement code.
- No explanations, comments, Markdown or code fences.
- The result must compile with Lean 4 and Mathlib.
- Use the existing variables, hypotheses and local context.
- Do not change anything outside the placeholder.
- Never use sorry, admit, or other placeholders.
- Do not invent assumptions or unavailable declarations.
- Prefer existing Mathlib lemmas over lengthy manual proofs.
- Use exact Lean 4 syntax.
- Preserve the syntactic structure required at the insertion point.
- If a tactic proof is appropriate, return the necessary tactic code.
- Do not return the word "claude".

Your output will be inserted directly into the source file.
`;

try {
  const dateipfad = path.startsWith("file://") ? fileURLToPath(path) : path;
  const kontext = fs.readFileSync(dateipfad, "utf8");

  const body = JSON.stringify({
    model: MODELL,
    stream: false,
    messages: [
    //   { role: "system", content: "Du hilfst bei Lean-4-Beweisen mit Mathlib. Antworte ausschließlich mit Lean-Code, ohne Erklärung und ohne Markdown." },
      { role: "system", content: SYSTEM_PROMPT },
    //   { role: "user", content: "Hier ist die Datei:\n\n" + kontext + "\n\nErsetze das nur letzte claude durch einen Beweis in Lean4. Gib nur den einzusetzenden Code zurück, der anstelle von 'claude' dort stehen soll" }
      { role: "user",
        content: `
        Here is the complete Lean 4 source file.

        <LEAN_SOURCE>
        ${kontext}
        </LEAN_SOURCE>

        Find the LAST occurrence of the exact placeholder "claude".

        Determine the complete local proof context, including:
        - The theorem statement
        - All available hypotheses
        - Local variables
        - Relevant definitions
        - The surrounding Lean syntax

        Return ONLY the Lean code that must replace that final occurrence.
        Do not repeat any surrounding source code.
        `
      }
    ]
  });

  const res = spawnSync("/usr/bin/curl", [
    "-sS", "--max-time", "3000",
    "http://localhost:11434/api/chat",
    "-d", "@-"
  ], { input: body, encoding: "utf8", maxBuffer: 10 * 1024 * 1024 });

  if (res.error) {
    rv = "-- Fehler: " + res.error.message;
  } else if (res.status !== 0) {
    rv = "-- Fehler (läuft Ollama?): " + res.stderr;
  } else {
    const data = JSON.parse(res.stdout);
    if (data.error) {
      rv = "-- Fehler: " + data.error;
    } else {
      rv = data.message.content.replace(/\x60{3}[a-z0-9]*\n?/gi, "").trim();
    }
  }
} catch (e) {
  rv = "-- Fehler: " + e.message;
}
``
endsnippet




#snippet claude "Lokales Modell fragen" wA
``
const fs = require("fs");
const { fileURLToPath } = require("url");
const { spawnSync } = require("child_process");

const MODELL = "qwen2.5-coder:7b";

const SYSTEM_PROMPT = `
You are an expert Lean 4 theorem prover specializing in Mathlib.

Your task is to replace the LAST occurrence of the exact placeholder
"claude" in the provided Lean source file with a valid Lean 4 proof.

STRICT RULES:
- Return ONLY the replacement Lean code.
- Do not include explanations, comments, Markdown or code fences.
- The result must compile with Lean 4 and Mathlib.
- Use only variables, hypotheses and definitions available in the local context.
- Do not modify anything outside the placeholder.
- Never use sorry, admit, or other placeholders.
- Do not invent assumptions, lemmas or declarations.
- Prefer existing Mathlib lemmas over lengthy manual proofs.
- Use exact Lean 4 syntax.
- Carefully inspect the syntax immediately before and after the placeholder.
- If the placeholder follows ":=", return a complete proof, usually beginning with "by".
- If the placeholder is inside an existing "by" block, return only the necessary tactics.
- If the proof requires multiple tactics, return all of them in the correct order.
- Do not return the word "claude".

The output will be inserted directly into the source file.
`;

try {
  if (typeof path !== "string" || path.length === 0) {
    throw new Error("Kein gültiger Dateipfad verfügbar.");
  }

  const dateipfad = path.startsWith("file://")
    ? fileURLToPath(path)
    : path;

  const kontext = fs.readFileSync(dateipfad, "utf8");

  const placeholder = "claude";
  const position = kontext.lastIndexOf(placeholder);

  if (position === -1) {
    throw new Error('Der Platzhalter "claude" wurde nicht gefunden.');
  }

  const body = JSON.stringify({
    model: MODELL,
    stream: false,
    options: {
      temperature: 0,
      top_p: 0.9,
      num_ctx: 16384,
      num_predict: 2048
    },
    messages: [
      {
        role: "system",
        content: SYSTEM_PROMPT
      },

    {
    role: "user",
    content:
        "Here is the complete Lean 4 source file:\n\n" +
        "<LEAN_SOURCE>\n" +
        kontext +
        "\n</LEAN_SOURCE>\n\n" +
        'The LAST occurrence of the exact text "claude" is the placeholder.\n' +
        "Its position in the source file is character " +
        position +
        ".\n\n" +
        "Analyze the surrounding code carefully. Determine the complete local proof " +
        "context, including the theorem statement, hypotheses, variables, definitions " +
        "and syntactic structure.\n\n" +
        "Return ONLY the Lean code that replaces this final placeholder. " +
        "Do not repeat any surrounding source code."
    }

    ]
  });

  const res = spawnSync("/usr/bin/curl", [
    "-sS",
    "--max-time", "300",
    "-H", "Content-Type: application/json",
    "--data-binary", "@-",
    "http://localhost:11434/api/chat"
  ], {
    input: body,
    encoding: "utf8",
    maxBuffer: 10 * 1024 * 1024
  });

  if (res.error) {
    rv = "-- Fehler: " + res.error.message;

  } else if (res.status !== 0) {
    rv = "-- Fehler (läuft Ollama?): " + res.stderr;

  } else {
    const data = JSON.parse(res.stdout);

    if (data.error) {
      rv = "-- Ollama-Fehler: " + data.error;

    } else if (!data.message || typeof data.message.content !== "string") {
      rv = "-- Fehler: Ollama hat keine gültige Antwort geliefert.";

    } else {
      rv = data.message.content
        .replace(/^```(?:lean4?|text)?\s*/i, "")
        .replace(/\s*```$/, "")
        .trim();

      if (!rv) {
        rv = "-- Fehler: Das Modell hat keinen Beweis zurückgegeben.";
      }

      if (rv.includes("sorry") || rv.includes("admit")) {
        rv = "-- Warnung: Das Modell hat einen unzulässigen Platzhalter ausgegeben:\n" + rv;
      }
    }
  }

} catch (e) {
  rv = "-- Fehler: " + e.message;
}
``
endsnippet




